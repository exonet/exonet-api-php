{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "before 4am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "The supported PHP range follows the CI test matrix and is updated by hand.",
      "matchManagers": [
        "composer"
      ],
      "matchDepNames": [
        "php"
      ],
      "enabled": false
    }
  ]
}
